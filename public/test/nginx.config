server {
    listen 443 ssl;
    server_name algaeprobanos.sdu.dk;   # optional – helps with “Host” header checks

    ssl_certificate     /etc/ssl/certs/server.crt;
    ssl_certificate_key /etc/ssl/private/server.key;

    # Optional hardening
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # Static site root
    root /var/www/html;
    index index.html;

    # Optional: send `/` to the dashboard app
    location = / { return 302 /dashboard/; }

    # Normalize without trailing slash (avoids relative-asset path issues)
    location = /dashboard { return 301 /dashboard/; }
    location = /bio { return 301 /bio/; }

    # Dashboard (Next.js static export) in /var/www/html/dashboard
    location ^~ /dashboard/_next/static/ {
      expires 1y;
      access_log off;
      try_files $uri =404;
    }
    location ^~ /dashboard/ {
      try_files $uri $uri/ /dashboard/index.html;
    }

    # Bio static app in /var/www/html/bio
    location ^~ /bio/ {
      try_files $uri $uri/ /bio/index.html;
    }

    # Route API
    location /api/ {
      proxy_pass http://127.0.0.1:5000;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;

      # If your backend uses WebSockets
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
    }
  }
